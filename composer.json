{
    "name": "vendor/flipa",
    "description": "Lightweight full-stack micro-framework, built from scratch with PHP 8.3.",
    "type": "project",
    "require": {
        "vlucas/phpdotenv": "^5.7",
        "php": ">=8.3"
    },
    "require-dev": {
        "filp/whoops": "^2.18",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files": [
            "core/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Flipa\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "oric28",
            "email": "orianacolina.perea@gmail.com"
        }
    ]
}
